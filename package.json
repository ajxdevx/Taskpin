{
  "name": "taskpin",
  "version": "1.0.0",
  "description": "Pin the files your agent needs \u2014 task-scoped, token-budgeted, explainable context packs (local, no API keys)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajxdevx/Taskpin.git"
  },
  "homepage": "https://github.com/ajxdevx/Taskpin#readme",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "taskpin": "dist/cli.js",
    "taskpin-mcp": "dist/mcp-main.js"
  },
  "files": [
    "dist",
    "schema",
    "docs/integrations",
    "docs/mcp.cursor.json"
  ],
  "scripts": {
    "build": "node api.js && tsc",
    "dev": "node api.js && tsc --watch",
    "taskpin": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "context",
    "llm",
    "cli",
    "taskpin",
    "coding-agent",
    "mcp",
    "claude",
    "copilot",
    "cursor"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vscode/ripgrep": "^1.18.0",
    "ignore": "^7.0.12",
    "zod": "^4.6.6"
  }
}
